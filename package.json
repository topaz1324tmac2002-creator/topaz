{
  "name": "jewelry-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "주얼리 스튜디오 — 브라우저에서 반지를 디자인하고 STL로 내보내는 웹앱 (1차 프로토타입)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify": "esbuild scripts/verify-core.ts --bundle --platform=node --format=esm --outfile=.verify/verify.mjs --log-level=warning && node .verify/verify.mjs",
    "preview:geo": "esbuild scripts/preview.ts --bundle --platform=node --format=esm --outfile=.verify/preview.mjs --log-level=warning && node .verify/preview.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "esbuild": "^0.21.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
